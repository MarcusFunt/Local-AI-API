FROM node:24.10.0-bookworm-slim@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    REPO_OPS_VERIFICATION_PYTHON=/opt/verification-venv/bin/python

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ripgrep docker-compose && \
    python3 -m venv "$VIRTUAL_ENV" && \
    python3 -m venv /opt/verification-venv && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-repo-ops.txt ./
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirements-repo-ops.txt && \
    /opt/verification-venv/bin/python -m pip install --upgrade pip && \
    /opt/verification-venv/bin/python -m pip install -r requirements.txt && \
    npm install --global gitnexus@1.6.7 axe-core@4.10.2 && \
    python -m playwright install --with-deps chromium

COPY repo_ops ./repo_ops
COPY agent_learning ./agent_learning
COPY lab_controller ./lab_controller

RUN groupadd --system repoops && \
    useradd --system --gid repoops --home-dir /home/repoops --create-home --shell /usr/sbin/nologin repoops && \
    git config --system --add safe.directory /source && \
    git config --system --add safe.directory /source/.git && \
    # Docker copies image-directory ownership into newly created named volumes.
    # Include /jobs so the unprivileged preview worker can initialize its queue.
    mkdir -p /jobs /workspaces /ms-playwright && \
    chown -R repoops:repoops /app /jobs /workspaces /ms-playwright /home/repoops

USER repoops
EXPOSE 8090

CMD ["/bin/sh", "-c", "python -m repo_ops.bootstrap && exec python -m repo_ops.server"]
