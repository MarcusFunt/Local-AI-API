# Ollama upstream — keep this pointing at localhost.
# Do NOT change to 0.0.0.0 or a remote host; see README for why.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gateway listen address — localhost only; Tailscale Serve forwards to this.
HOST=127.0.0.1
PORT=8080

# Default model profile when the client omits the "model" field.
# Common values: main, small, dev, agent, agent-utility.
# Direct approved model tags are also accepted.
DEFAULT_MODEL_PROFILE=main

# Space-separated Ollama model tags to pull during Docker install/update.
# Defaults to the core supported profiles when unset.
OLLAMA_MODELS=qwen3.5:9b qwen3.5:4b qwen3.5:0.8b

# Local speech-to-text via Whisper.
# Allowed values: none, tiny, base, small.
# Choose none to disable transcription unless clients explicitly send a model.
DEFAULT_WHISPER_MODEL=none
WHISPER_DEVICE=auto
WHISPER_CACHE_DIR=/models/cache/whisper

# Local text-to-speech via Chatterbox.
# Allowed values: chatterbox, chatterbox-multilingual.
CHATTERBOX_MODEL=chatterbox
CHATTERBOX_DEVICE=auto

# Set to true to allow any model name to be forwarded to Ollama.
# Leave false to restrict to the built-in profiles documented in README.
ENABLE_ARBITRARY_MODELS=false

# Optional Agent Zero UI support.
# When true, the Windows installer starts Agent Zero, pulls its approved local
# models, and exposes its UI only through localhost/Tailscale Serve.
AGENT_ZERO_ENABLED=false
AGENT_ZERO_PORT=50080
AGENT_ZERO_TAILSCALE_HTTPS_PORT=8443
AGENT_ZERO_IMAGE_TAG=latest

# Optional bearer-token auth (disabled by default).
# Tailscale Serve is the primary access-control layer; this is an extra safeguard.
# To enable: set ENABLE_API_KEY_AUTH=true and set a strong API_KEY value.
ENABLE_API_KEY_AUTH=false
API_KEY=

# Maximum time (seconds) to wait for Ollama to respond.
REQUEST_TIMEOUT_SECONDS=600

# Maximum allowed request body size in bytes (default: 10 MiB).
MAX_REQUEST_BODY_BYTES=10485760

# Docker deployment options.
# The installer selects CPU, NVIDIA, or AMD/ROCm compose overrides automatically.
OLLAMA_IMAGE_TAG=latest
OLLAMA_KEEP_ALIVE=5m

# Build the gateway image with local Whisper and Chatterbox runtime dependencies.
# Set false for chat-only deployments.
INSTALL_AUDIO=true
