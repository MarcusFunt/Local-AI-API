# Ollama upstream — keep this pointing at localhost.
# Do NOT change to 0.0.0.0 or a remote host; see README for why.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gateway listen address — localhost only; Tailscale Serve forwards to this.
HOST=127.0.0.1
PORT=8080

# Default model profile when the client omits the "model" field.
# Common values: main, small, dev, agent, agent-utility.
# Direct approved model tags are also accepted.
DEFAULT_MODEL_PROFILE=main

# Space-separated Ollama model tags to pull during Docker install/update.
# Defaults to the core and Agent Zero supported profiles when unset.
OLLAMA_MODELS=qwen3.5:9b qwen3.5:4b qwen3.5:0.8b qwen3:14b qwen3:8b

# Local speech-to-text via Whisper.
# Allowed values: none, tiny, base, small.
# Choose none to disable transcription unless clients explicitly send a model.
DEFAULT_WHISPER_MODEL=none
WHISPER_DEVICE=auto
WHISPER_CACHE_DIR=/models/cache/whisper

# Local text-to-speech via Chatterbox.
# Allowed values: chatterbox, chatterbox-multilingual.
CHATTERBOX_MODEL=chatterbox
CHATTERBOX_DEVICE=auto

# Set to true to load the Whisper and Chatterbox models in the background at
# startup, so the first speech request is fast instead of paying a one-time
# ~1-2 GB download + model-load. Best-effort; failures are logged and ignored.
WARM_AUDIO_ON_START=false

# Set to true to allow any model name to be forwarded to Ollama.
# Leave false to restrict to the built-in profiles documented in README.
ENABLE_ARBITRARY_MODELS=false

# Mandatory Agent Zero UI support.
# Installers start Agent Zero, pull its approved local models, and expose its UI
# only through localhost/Tailscale Serve. This legacy flag is kept true for
# compatibility with existing .env files and status payloads.
# The Agent Zero Docker override writes API_KEY into Agent Zero's API_KEY_OTHER
# setting automatically; when API_KEY is empty, it uses the dummy key "unused".
AGENT_ZERO_ENABLED=true
AGENT_ZERO_PORT=50080
AGENT_ZERO_TAILSCALE_HTTPS_PORT=8443
AGENT_ZERO_IMAGE_TAG=latest

# Isolated repository-worker lifecycle. These are used only with the opt-in
# compose.repo-ops.yaml overlay; archives remain local and are host-backed.
REPO_OPS_ARCHIVE_HOST_PATH=./.local/repo-ops-archives
REPO_OPS_ACTIVE_LEASE_HOURS=24
REPO_OPS_WORKSPACE_TTL_DAYS=7
REPO_OPS_ARCHIVE_TTL_DAYS=14
REPO_OPS_SWEEP_INTERVAL_SECONDS=21600
# Autonomous improvements stay in disposable workspaces. They never push,
# merge, deploy, or access the source checkout. The hard runtime limit is 24h.
REPO_OPS_AUTONOMY_ENABLED=false
REPO_OPS_AUTONOMY_MAX_STORAGE_GIB=20
AGENT_ZERO_COCKPIT_ENABLED=false

# Optional bearer-token auth (disabled by default).
# Tailscale Serve is the primary access-control layer; this is an extra safeguard.
# To enable: set ENABLE_API_KEY_AUTH=true and set a strong API_KEY value.
ENABLE_API_KEY_AUTH=false
API_KEY=

# Maximum time (seconds) to wait for Ollama to respond.
REQUEST_TIMEOUT_SECONDS=600

# Maximum allowed request body size in bytes (default: 10 MiB).
MAX_REQUEST_BODY_BYTES=10485760

# Docker deployment options.
# The installer selects CPU, NVIDIA, or AMD/ROCm compose overrides automatically.
OLLAMA_IMAGE_TAG=latest
OLLAMA_KEEP_ALIVE=5m

# Build the gateway image with local Whisper and Chatterbox runtime dependencies.
# Set false for chat-only deployments.
INSTALL_AUDIO=true

# Docker-side GitHub update monitor. The repo-updater container polls this
# checkout, fast-forwards only a clean main branch, then rebuilds/restarts the
# gateway. It needs Docker socket access to perform that restart.
REPO_UPDATE_REMOTE=origin
REPO_UPDATE_BRANCH=main
REPO_UPDATE_INTERVAL_SECONDS=300
# For custom Compose overlays, set a space-separated list, for example:
# REPO_UPDATE_COMPOSE_FILES=compose.yaml compose.cpu.yaml compose.qdrant.yaml
REPO_UPDATE_COMPOSE_FILES=

# RAG (Retrieval-Augmented Generation) — requires compose.qdrant.yaml overlay.
# Start with:
#   docker compose -f compose.yaml -f compose.qdrant.yaml [-f compose.cpu.yaml] up -d
# Before first use, pull the embedding model:
#   docker compose exec ollama ollama pull nomic-embed-text
RAG_ENABLED=false
INSTALL_RAG=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=local-ai-api-docs
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_DIM=768
RAG_TOP_K=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
