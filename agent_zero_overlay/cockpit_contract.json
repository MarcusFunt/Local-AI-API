{
  "name": "local-ai-api-workspace-cockpit",
  "version": 2,
  "required_actions": [
    "candidate_status",
    "archive_workspace",
    "autonomous_status",
    "create_workspace",
    "evaluate_workspace",
    "git_diff",
    "list_workspaces",
    "pause_autonomous_run",
    "preview_workspace",
    "resume_autonomous_run",
    "start_autonomous_run",
    "stop_autonomous_run",
    "task_report",
    "workspace_health"
  ],
  "security": {
    "browser_direct_repo_ops_access": false,
    "requires_authenticated_backend_proxy": true,
    "allows_merge_push_deploy": false
  }
}
